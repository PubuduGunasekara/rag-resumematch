# Copy this file to .env and adjust if you want different defaults.
# .env is gitignored; never commit it even though nothing secret lives
# here yet (keeps the habit correct for when something does).

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b          # measured more accurate and faster than llama3.1:8b (docs/design.md)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHROMA_PERSIST_DIR=./chroma_db

# Kaggle API credentials (required for scripts/build_index.py's
# automated dataset download). Get yours: kaggle.com -> Settings -> API
# -> Create New Token -> open the downloaded kaggle.json for these values.
KAGGLE_USERNAME=
KAGGLE_KEY=

# Used by gcp/start.sh and gcp/stop.sh, not read by the app itself.
GCP_PROJECT_ID=
GCP_ZONE=us-central1-a
GCP_INSTANCE_NAME=resumematch-vm

# Sign-in (api/auth.py). Four demo accounts share one password:
# seeker@example.com, recruiter@example.com, advisor@example.com, admin@example.com.
# The default password is public (it's in the README) and the login page fills it in,
# so anyone can try the demo. For a closed demo, set your own password and
# DEMO_PASSWORD_PUBLIC=0. Leave DEMO_PASSWORD empty and nobody can sign in.
DEMO_PASSWORD=resumematch-demo
DEMO_PASSWORD_PUBLIC=1
# Signs session cookies. Any long random string; generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=
# Set to 1 when the site is served over HTTPS (the GCP deployment), so the cookie is Secure.
COOKIE_SECURE=0
