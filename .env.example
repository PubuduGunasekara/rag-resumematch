# Copy this file to .env and adjust if you want different defaults.
# .env is gitignored; never commit it even though nothing secret lives
# here yet (keeps the habit correct for when something does).

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b          # measured more accurate and faster than llama3.1:8b (docs/design.md)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHROMA_PERSIST_DIR=./chroma_db

# Kaggle API credentials (required for scripts/build_index.py's
# automated dataset download). Get yours: kaggle.com -> Settings -> API
# -> Create New Token -> open the downloaded kaggle.json for these values.
KAGGLE_USERNAME=
KAGGLE_KEY=

# Used by gcp/start.sh and gcp/stop.sh, not read by the app itself.
GCP_PROJECT_ID=
GCP_ZONE=us-central1-a
GCP_INSTANCE_NAME=resumematch-vm
