# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Env / secrets
.env

# Personal data: real resumes and raw postings never go into git history,
# even in a private repo. Keep them local only.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
# Real resumes used for testing stay here, never in eval/resumes/
eval/private/

# ChromaDB local persistence
chroma_db/
*.sqlite3

# OS / editor
.DS_Store
.vscode/
.idea/

# Built release artifacts (scripts/make_sample_index.py)
dist/
